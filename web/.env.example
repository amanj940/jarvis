# JARVIS backend connection — the single source for host/port (Phase 2).
# Copy this file to `.env` to override. The web app reads these through
# Vite (VITE_* vars, see src/lib/config.ts) and electron/main.cjs reads
# the same file, so the shell and the renderer always agree.
VITE_JARVIS_HOST=127.0.0.1
VITE_JARVIS_PORT=7341
